// Cloudflare Worker 설정. see docs/13-deployment.md §2, docs/modules/worker.md
// R2·KV 리소스(M02-T06, 2026-09-29 생성, 위치 힌트 apac): production = sanpo-world-prod + KV SANPO_CONFIG,
// staging = sanpo-world-dev + KV SANPO_CONFIG_STAGING(바인딩은 env 간 상속되지 않으므로 양쪽에 둔다). 퍼블리시·포인터 = `pnpm pipeline publish`.
// env.local은 `pnpm dev`(wrangler dev --env local) 전용 — R2/KV를 miniflare가 .wrangler/state에 시뮬레이션한다.
// LIVE_WEATHER(/api/weather Open-Meteo, M09-T01 ADR-0076): staging·local = true, production = false(공개 배포 결정 전 — Open-Meteo 무료 API는 비상업 한정).
// 실제 리소스가 없으므로 배포 불가(배포하지 말 것). 시드: `pnpm --filter @sanpo/worker seed:local` (ADR-0016)
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tokyo-sanpo",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // production은 커스텀 도메인 earthaimap.com만(ADR-0103): workers.dev·버전 프리뷰 주소는 존 WAF·킬 스위치(ADR-0104)를 우회하므로 끈다.
  // staging은 PR 프리뷰(`pr-<N>` 별칭) 때문에 env.staging에서 다시 켠다(이 두 키는 env로 상속되므로 명시).
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../game/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/world/*", "/api/*"]
  },
  // 관측 로그(ADR-0103): 요청 URL의 쿼리 문자열은 로그·트레이스에서 지운다(redact_query_string — 기본 false였음). 보존 = Workers Paid 7일(설정 불가).
  "observability": { "enabled": true, "redact_query_string": true },
  // 오류 보고(M11-T03): Workers Analytics Engine — Workers Paid 주기당 1,000만 점 포함(아직 미과금, docs/13 §6), 데이터셋은 첫 기록 때 생긴다. 조회 = `pnpm errors`(SQL API).
  "analytics_engine_datasets": [{ "binding": "LOGS", "dataset": "sanpo_errors" }],
  "vars": { "LIVE_WEATHER": "false", "WORLD_BASE_URL": "/world", "DEPLOY_ENV": "production" },
  // /api/log IP(해시) 요청 제한(F03, ADR-0103): 분당 10회 — 게임은 세션당 최대 3건. PoP 단위 근사 카운터, env 간 상속 안 됨(namespace_id = 계정 안 고유 정수).
  "ratelimits": [{ "name": "LOG_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  "r2_buckets": [{ "binding": "WORLD", "bucket_name": "sanpo-world-prod" }],
  "kv_namespaces": [{ "binding": "CONFIG", "id": "938aa34bc73f4cce935ab383fbc0a098" }],
  "env": {
    "staging": {
      "name": "tokyo-sanpo-staging",
      "workers_dev": true,
      "preview_urls": true,
      "analytics_engine_datasets": [{ "binding": "LOGS", "dataset": "sanpo_errors_staging" }],
      "vars": { "LIVE_WEATHER": "true", "WORLD_BASE_URL": "/world", "DEPLOY_ENV": "staging" },
      "ratelimits": [{ "name": "LOG_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }],
      "r2_buckets": [{ "binding": "WORLD", "bucket_name": "sanpo-world-dev" }],
      "kv_namespaces": [{ "binding": "CONFIG", "id": "52e1d2e4354047cda47550e03f0750b4" }]
    },
    "local": {
      "name": "tokyo-sanpo-local",
      "workers_dev": false,
      "preview_urls": false,
      "vars": { "LIVE_WEATHER": "true", "WORLD_BASE_URL": "/world", "DEPLOY_ENV": "local" },
      "r2_buckets": [{ "binding": "WORLD", "bucket_name": "sanpo-world-local" }],
      "kv_namespaces": [{ "binding": "CONFIG", "id": "sanpo-config-local" }]
    }
  }
}
