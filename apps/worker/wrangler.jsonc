// Cloudflare Worker 설정. see docs/13-deployment.md §2, docs/modules/worker.md
// R2·KV 리소스(M02-T06, 2026-09-29 생성, 위치 힌트 apac): production = sanpo-world-prod + KV SANPO_CONFIG,
// staging = sanpo-world-dev + KV SANPO_CONFIG_STAGING(바인딩은 env 간 상속되지 않으므로 양쪽에 둔다). 퍼블리시·포인터 = `pnpm pipeline publish`.
// env.local은 `pnpm dev`(wrangler dev --env local) 전용 — R2/KV를 miniflare가 .wrangler/state에 시뮬레이션한다.
// 실제 리소스가 없으므로 배포 불가(배포하지 말 것). 시드: `pnpm --filter @sanpo/worker seed:local` (ADR-0016)
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tokyo-sanpo",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "../game/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/world/*", "/api/*"]
  },
  "observability": { "enabled": true },
  "vars": { "LIVE_WEATHER": "false", "WORLD_BASE_URL": "/world" },
  "r2_buckets": [{ "binding": "WORLD", "bucket_name": "sanpo-world-prod" }],
  "kv_namespaces": [{ "binding": "CONFIG", "id": "938aa34bc73f4cce935ab383fbc0a098" }],
  "env": {
    "staging": {
      "name": "tokyo-sanpo-staging",
      "vars": { "LIVE_WEATHER": "false", "WORLD_BASE_URL": "/world" },
      "r2_buckets": [{ "binding": "WORLD", "bucket_name": "sanpo-world-dev" }],
      "kv_namespaces": [{ "binding": "CONFIG", "id": "52e1d2e4354047cda47550e03f0750b4" }]
    },
    "local": {
      "name": "tokyo-sanpo-local",
      "workers_dev": false,
      "preview_urls": false,
      "vars": { "LIVE_WEATHER": "false", "WORLD_BASE_URL": "/world" },
      "r2_buckets": [{ "binding": "WORLD", "bucket_name": "sanpo-world-local" }],
      "kv_namespaces": [{ "binding": "CONFIG", "id": "sanpo-config-local" }]
    }
  }
}
