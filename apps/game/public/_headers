# 정적 에셋 응답 헤더(Workers Static Assets). Worker 응답(/api/*, /world/*)은 apps/worker/src/headers.ts가 담당.
# COOP/COEP → crossOriginIsolated(SharedArrayBuffer, Jolt 멀티스레드). see docs/13-deployment.md §3
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; img-src 'self' data: blob:; connect-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'
  X-Content-Type-Options: nosniff
/fixtures/*
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
