{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!data",
      "!docs",
      "!schemas",
      "!content",
      "!pnpm-lock.yaml",
      "!packages/geo/test/golden.json",
      "!tests/fixtures"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": { "quoteStyle": "single" }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noConsole": "error",
        "noExplicitAny": "error"
      },
      "style": {
        "noEnum": "error",
        "noExcessiveLinesPerFile": { "level": "error", "options": { "maxLines": 400 } }
      },
      "complexity": {
        "noExcessiveLinesPerFunction": { "level": "error", "options": { "maxLines": 60 } }
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/test/**", "**/*.test.ts"],
      "linter": { "rules": { "complexity": { "noExcessiveLinesPerFunction": "off" } } }
    }
  ]
}
