{
  "name": "tokyo-sanpo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "check": "biome check . && tsc -p tsconfig.json && depcruise packages apps tools",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json",
    "depcruise": "depcruise packages apps tools",
    "test": "vitest run",
    "codemap": "node tools/codemap/src/index.ts",
    "pipeline": "node tools/pipeline/src/cli.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "dependency-cruiser": "18.4.0",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
