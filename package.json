{
  "name": "tokyo-sanpo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @sanpo/worker --filter @sanpo/game dev",
    "check": "biome check . && pnpm typecheck && depcruise packages apps tools && node scripts/check-size.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "depcruise": "depcruise packages apps tools",
    "test": "vitest run",
    "build": "pnpm --filter @sanpo/game build && pnpm --filter @sanpo/worker build",
    "check:size": "node scripts/check-size.ts",
    "check:assets": "node scripts/check-asset-size.ts",
    "check:records": "node scripts/check-records.ts",
    "codemap": "node tools/codemap/src/index.ts",
    "pipeline": "node tools/pipeline/src/cli.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "22.20.4",
    "dependency-cruiser": "18.4.0",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
