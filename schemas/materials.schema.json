{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sanpo/materials",
  "title": "world/<buildId>/shared/materials/manifest.json (M03-T01, 07 §4)",
  "type": "object",
  "required": ["schema", "layerCount", "textures", "layers", "groups", "hash"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": 1 },
    "layerCount": { "type": "integer", "minimum": 1, "maximum": 64 },
    "textures": {
      "type": "object",
      "required": ["albedo", "normal", "orm"],
      "additionalProperties": false,
      "patternProperties": {
        "^(albedo|normal|orm)$": {
          "type": "object",
          "required": ["file", "bytes", "size", "encode", "colorSpace"],
          "additionalProperties": false,
          "properties": {
            "file": { "type": "string", "pattern": "^[a-z0-9_-]+[.]ktx2$" },
            "bytes": { "type": "integer", "minimum": 1 },
            "size": { "type": "integer", "minimum": 64, "maximum": 2048 },
            "encode": { "enum": ["etc1s", "uastc"] },
            "colorSpace": { "enum": ["srgb", "linear"] }
          }
        }
      }
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "group", "index", "tileM", "avgColor", "avgOrm", "source"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]{1,40}$" },
          "group": { "type": "string", "pattern": "^[a-z0-9_]{1,40}$" },
          "index": { "type": "integer", "minimum": 0 },
          "tileM": { "type": "number", "exclusiveMinimum": 0, "maximum": 20 },
          "avgColor": { "type": "array", "items": { "type": "number", "minimum": 0, "maximum": 1 }, "minItems": 3, "maxItems": 3 },
          "avgOrm": { "type": "array", "items": { "type": "number", "minimum": 0, "maximum": 1 }, "minItems": 3, "maxItems": 3 },
          "source": { "type": "string", "pattern": "^ambientcg:[A-Za-z0-9]+$" }
        }
      }
    },
    "groups": {
      "type": "object",
      "additionalProperties": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "minItems": 1 }
    },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{16}$" }
  }
}
